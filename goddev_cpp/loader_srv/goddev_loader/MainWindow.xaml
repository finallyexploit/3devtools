<Window x:Class="loader_goddev.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GOD DEV"
        Width="560"
        Height="620"
        MinWidth="560"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Icon="Assets/goddev.ico"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#05070A"/>
        <SolidColorBrush x:Key="Shell" Color="#080B11"/>
        <SolidColorBrush x:Key="Panel" Color="#0C1118"/>
        <SolidColorBrush x:Key="PanelAlt" Color="#0F141C"/>
        <SolidColorBrush x:Key="Surface" Color="#101722"/>
        <SolidColorBrush x:Key="SurfaceAlt" Color="#0C121A"/>
        <SolidColorBrush x:Key="Stroke" Color="#1C2734"/>
        <SolidColorBrush x:Key="StrokeSoft" Color="#141D28"/>
        <SolidColorBrush x:Key="Accent" Color="#7DFF76"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#112318"/>
        <SolidColorBrush x:Key="AccentStroke" Color="#254531"/>
        <SolidColorBrush x:Key="Text" Color="#F2F7FB"/>
        <SolidColorBrush x:Key="TextSoft" Color="#95A6B9"/>
        <SolidColorBrush x:Key="TextMuted" Color="#65768A"/>
        <SolidColorBrush x:Key="Danger" Color="#FF6F85"/>
        <SolidColorBrush x:Key="Success" Color="#5CF5A8"/>
        <SolidColorBrush x:Key="FocusStroke" Color="#325167"/>
        <SolidColorBrush x:Key="TopButtonHover" Color="#121A25"/>
        <SolidColorBrush x:Key="ButtonHoverStroke" Color="#32475B"/>
        <SolidColorBrush x:Key="ButtonGloss" Color="#28FFFFFF"/>
        <SolidColorBrush x:Key="TabActiveBg" Color="#111925"/>
        <SolidColorBrush x:Key="ShellEdge" Color="#121A24"/>
        <SolidColorBrush x:Key="BrandTileBg" Color="#101823"/>
        <SolidColorBrush x:Key="HeaderTileBg" Color="#0E151F"/>
        <SolidColorBrush x:Key="LoginMarkBg" Color="#0F1722"/>
        <SolidColorBrush x:Key="StatusBg" Color="#0A1119"/>

        <LinearGradientBrush x:Key="ChromeLine" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#49B7FF" Offset="0"/>
            <GradientStop Color="#8A5CFF" Offset="0.44"/>
            <GradientStop Color="#FF5A7A" Offset="0.74"/>
            <GradientStop Color="#7DFF76" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="MainButtonFill" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#171F2A" Offset="0"/>
            <GradientStop Color="#101720" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PrimaryButtonFill" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#112317" Offset="0"/>
            <GradientStop Color="#153020" Offset="1"/>
        </LinearGradientBrush>

        <DropShadowEffect x:Key="ShellShadow" BlurRadius="30" ShadowDepth="0" Opacity="0.34" Color="#000000"/>

        <Style x:Key="TopButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource TopButtonHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Panel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceAlt}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="1,0,1,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource FocusStroke}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PasswordStyle" TargetType="PasswordBox">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceAlt}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="1,0,1,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource FocusStroke}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Background" Value="{DynamicResource MainButtonFill}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <Grid>
                                <Border Height="1" VerticalAlignment="Top" Background="{DynamicResource ButtonGloss}" CornerRadius="14,14,0,0"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource ButtonHoverStroke}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.94"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.56"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource PrimaryButtonFill}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentStroke}"/>
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        </Style>

        <Style x:Key="ChipButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextSoft}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="MinWidth" Value="42"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource TabActiveBg}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TabButtonStyle" TargetType="Button" BasedOn="{StaticResource ChipButtonStyle}">
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="CheckStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextSoft}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="16" Height="16"
                                    Background="{DynamicResource SurfaceAlt}"
                                    BorderBrush="{DynamicResource StrokeSoft}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    VerticalAlignment="Center">
                                <Path x:Name="CheckMark"
                                      Data="M2,8 L6,12 L14,3"
                                      Stroke="{DynamicResource Accent}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource Bg}">
        <Border x:Name="ShellBorder"
                Margin="18"
                Background="{DynamicResource Shell}"
                BorderBrush="{DynamicResource ShellEdge}"
                BorderThickness="1"
                CornerRadius="26"
                Opacity="0"
                Effect="{DynamicResource ShellShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="3"/>
                    <RowDefinition Height="62"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Margin="16,0,16,0" Background="{DynamicResource ChromeLine}" CornerRadius="18"/>

                <Grid Grid.Row="1" Margin="18,12,18,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="36" Height="36" CornerRadius="11"
                                Background="{DynamicResource BrandTileBg}"
                                BorderBrush="{DynamicResource Stroke}"
                                BorderThickness="1" Margin="0,0,12,0">
                            <Image Source="Assets/goddev-mark.png" Width="24" Height="24"
                                   Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource Text}" FontSize="15" FontWeight="Bold">
                                <Run Text="GOD" Foreground="{DynamicResource Accent}"/>
                                <Run Text=" DEV"/>
                            </TextBlock>
                            <TextBlock Foreground="{DynamicResource TextMuted}" FontSize="10" Text="compact secure shell"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel x:Name="HeaderSessionPanel" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="0,0,12,0" Visibility="Collapsed">
                            <Border Width="34" Height="34" CornerRadius="11"
                                    Background="{DynamicResource HeaderTileBg}"
                                    BorderBrush="{DynamicResource Stroke}" BorderThickness="1">
                                <Grid>
                                    <Image Source="Assets/goddev-mark.png" Width="20" Height="20"
                                           Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            Background="{DynamicResource AccentSoft}"
                                            BorderBrush="{DynamicResource AccentStroke}"
                                            BorderThickness="1" CornerRadius="8"
                                            Padding="4,1" Margin="0,0,-5,-5">
                                        <TextBlock x:Name="UserBadgeText" Foreground="{DynamicResource Accent}"
                                                   FontSize="9" FontWeight="Bold" Text="GD"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="HeaderUserText" Foreground="{DynamicResource Text}"
                                           FontSize="12" FontWeight="SemiBold" Text="guest"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="HeaderHintText" Margin="0,3,0,0"
                                           Foreground="{DynamicResource TextSoft}" FontSize="10" Text="offline"/>
                            </StackPanel>
                        </StackPanel>

                        <Border x:Name="ThemeSwitcherPanel"
                                Background="{DynamicResource HeaderTileBg}"
                                BorderBrush="{DynamicResource StrokeSoft}"
                                BorderThickness="1" CornerRadius="14"
                                Padding="4" Margin="0,0,8,0"
                                Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="ThemeStandardButton" Style="{DynamicResource ChipButtonStyle}"
                                        Content="STD" Tag="standard" Click="ThemeButton_Click" ToolTip="Standard theme"/>
                                <Button x:Name="ThemeBlackButton" Style="{DynamicResource ChipButtonStyle}"
                                        Content="BLK" Tag="black" Click="ThemeButton_Click"
                                        Margin="4,0,0,0" ToolTip="Black theme"/>
                                <Button x:Name="ThemeWhiteButton" Style="{DynamicResource ChipButtonStyle}"
                                        Content="WHT" Tag="white" Click="ThemeButton_Click"
                                        Margin="4,0,0,0" ToolTip="White theme"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource HeaderTileBg}"
                                BorderBrush="{DynamicResource StrokeSoft}"
                                BorderThickness="1" CornerRadius="14"
                                Padding="4" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="LangEnButton" Style="{DynamicResource ChipButtonStyle}"
                                        Content="EN" Tag="en" Click="LangButton_Click"/>
                                <Button x:Name="LangRuButton" Style="{DynamicResource ChipButtonStyle}"
                                        Content="RU" Tag="ru" Click="LangButton_Click" Margin="4,0,0,0"/>
                                <Button x:Name="LangUkButton" Style="{DynamicResource ChipButtonStyle}"
                                        Content="UK" Tag="uk" Click="LangButton_Click" Margin="4,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <Button Style="{DynamicResource TopButtonStyle}" Click="Minimize_Click" Content="−" Margin="0,0,6,0"/>
                        <Button Style="{DynamicResource TopButtonStyle}" Click="Close_Click" Content="×"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2" Margin="18,0,18,14">
                    <Grid x:Name="LoginView" Visibility="Visible" Opacity="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="1" Style="{DynamicResource CardStyle}"
                                    Width="392" HorizontalAlignment="Center" Padding="26">
                                <StackPanel>
                                    <StackPanel HorizontalAlignment="Center">
                                        <Border Width="62" Height="62" CornerRadius="19"
                                                Background="{DynamicResource LoginMarkBg}"
                                                BorderBrush="{DynamicResource AccentStroke}"
                                                BorderThickness="1"
                                                HorizontalAlignment="Center">
                                            <Image Source="Assets/goddev-mark.png" Width="38" Height="38"
                                                   Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock x:Name="LoginCardTitle"
                                                   Margin="0,16,0,0"
                                                   Foreground="{DynamicResource Text}"
                                                   FontSize="21" FontWeight="Bold"
                                                   Text="Secure access"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="LoginCardHint"
                                                   Margin="0,8,0,0"
                                                   Foreground="{DynamicResource TextSoft}"
                                                   FontSize="11"
                                                   Text="Enter your account details to continue."
                                                   TextAlignment="Center" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <Border Height="1" Margin="0,22,0,0"
                                            Background="{DynamicResource StrokeSoft}" CornerRadius="1"/>

                                    <TextBlock x:Name="UsernameLabel"
                                               Margin="0,20,0,8"
                                               Foreground="{DynamicResource TextSoft}"
                                               FontSize="11" FontWeight="SemiBold"
                                               Text="Username"/>
                                    <TextBox x:Name="UsernameBox"
                                             Style="{DynamicResource InputStyle}"
                                             Height="44" MaxLength="64"
                                             KeyDown="AuthKeyDown"
                                             LostKeyboardFocus="UsernameBox_LostKeyboardFocus"/>

                                    <TextBlock x:Name="PasswordLabel"
                                               Margin="0,14,0,8"
                                               Foreground="{DynamicResource TextSoft}"
                                               FontSize="11" FontWeight="SemiBold"
                                               Text="Password"/>
                                    <PasswordBox x:Name="PasswordBox"
                                                 Style="{DynamicResource PasswordStyle}"
                                                 Height="44" MaxLength="128"
                                                 KeyDown="AuthKeyDown"/>

                                    <CheckBox x:Name="RememberUsernameCheck"
                                              Margin="0,12,0,0"
                                              Style="{DynamicResource CheckStyle}"
                                              Checked="RememberUsernameChanged"
                                              Unchecked="RememberUsernameChanged"
                                              Content="Remember username"/>

                                    <Button x:Name="LoginButton"
                                            Margin="0,18,0,0"
                                            Height="46"
                                            Style="{DynamicResource PrimaryButtonStyle}"
                                            Click="Login_Click"
                                            Content="Sign in"/>

                                    <Border Margin="0,14,0,0"
                                            Background="{DynamicResource PanelAlt}"
                                            BorderBrush="{DynamicResource StrokeSoft}"
                                            BorderThickness="1" CornerRadius="14"
                                            Padding="14,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="7" Height="7"
                                                         Fill="{DynamicResource Accent}"
                                                         VerticalAlignment="Center"/>
                                                <TextBlock x:Name="LoginMetric1Title"
                                                           Margin="8,0,0,0"
                                                           Foreground="{DynamicResource TextMuted}"
                                                           FontSize="10" FontWeight="SemiBold"
                                                           Text="security"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock x:Name="LoginMetric1Value"
                                                       Grid.Column="1"
                                                       Foreground="{DynamicResource Accent}"
                                                       FontSize="11" FontWeight="Bold"
                                                       VerticalAlignment="Center"
                                                       Text="ready"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid x:Name="AppView" Visibility="Collapsed" Opacity="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock x:Name="PageTitleText" Foreground="{DynamicResource Text}"
                                           FontSize="28" FontWeight="Bold" Text="Account details"/>
                                <TextBlock x:Name="PageSubtitleText" Margin="0,6,0,0"
                                           Foreground="{DynamicResource TextSoft}" FontSize="12"
                                           Text="Current session and access details."/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="NavAccountButton" Style="{DynamicResource TabButtonStyle}"
                                        Click="NavAccount_Click" Content="Account"/>
                                <Button x:Name="NavLicenseButton" Style="{DynamicResource TabButtonStyle}"
                                        Click="NavLicense_Click" Content="License" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{DynamicResource CardStyle}">
                                <StackPanel>
                                    <TextBlock x:Name="CardUserTitle" Style="{DynamicResource CardTitleStyle}" Text="user"/>
                                    <TextBlock x:Name="CardUserValue" Margin="0,10,0,0"
                                               Foreground="{DynamicResource Text}"
                                               FontSize="18" FontWeight="Bold" Text="-"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{DynamicResource CardStyle}">
                                <StackPanel>
                                    <TextBlock x:Name="CardBalanceTitle" Style="{DynamicResource CardTitleStyle}" Text="balance"/>
                                    <TextBlock x:Name="CardBalanceValue" Margin="0,10,0,0"
                                               Foreground="{DynamicResource Text}"
                                               FontSize="18" FontWeight="Bold" Text="$0.00"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="4" Style="{DynamicResource CardStyle}">
                                <StackPanel>
                                    <TextBlock x:Name="CardLicenseTitle" Style="{DynamicResource CardTitleStyle}" Text="license"/>
                                    <TextBlock x:Name="CardLicenseValue" Margin="0,10,0,0"
                                               Foreground="{DynamicResource Text}"
                                               FontSize="18" FontWeight="Bold" Text="none"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.35*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{DynamicResource CardStyle}">
                                <StackPanel>
                                    <TextBlock x:Name="InfoTitle" Foreground="{DynamicResource Text}"
                                               FontSize="18" FontWeight="Bold" Text="Account details"/>
                                    <TextBlock x:Name="InfoHint" Margin="0,6,0,0"
                                               Foreground="{DynamicResource TextSoft}" FontSize="11"
                                               Text="Current session and access details."/>
                                    <TextBox x:Name="InfoBox"
                                             Margin="0,16,0,0"
                                             Height="340"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             IsReadOnly="True"
                                             Style="{DynamicResource InputStyle}"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Column="2">
                                <Border x:Name="LicensePanel" Style="{DynamicResource CardStyle}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock x:Name="LicenseKeyLabel" Foreground="{DynamicResource Text}"
                                                   FontSize="11" FontWeight="SemiBold" Text="License key"/>
                                        <TextBlock x:Name="LicenseKeyHint" Margin="0,6,0,0"
                                                   Foreground="{DynamicResource TextSoft}" FontSize="11"
                                                   Text="Check the active key and read the current record."
                                                   TextWrapping="Wrap"/>
                                        <TextBox x:Name="LicenseKeyBox"
                                                 Margin="0,14,0,0"
                                                 Style="{DynamicResource InputStyle}"
                                                 Height="44" MaxLength="128"/>
                                        <Button x:Name="FetchLicenseButton"
                                                Margin="0,12,0,0"
                                                Style="{DynamicResource ButtonStyle}"
                                                Height="44"
                                                Click="FetchLicense_Click"
                                                Content="Load key"/>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="SecurityPanel" Style="{DynamicResource CardStyle}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock x:Name="SecurityTitle" Foreground="{DynamicResource Text}"
                                                   FontSize="18" FontWeight="Bold" Text="Security module"/>
                                        <TextBlock x:Name="SecurityHint" Margin="0,6,0,0"
                                                   Foreground="{DynamicResource TextSoft}" FontSize="11"
                                                   Text="Integrity, launch and storage checks."
                                                   TextWrapping="Wrap"/>
                                        <Border Margin="0,14,0,0"
                                                Background="{DynamicResource PanelAlt}"
                                                BorderBrush="{DynamicResource StrokeSoft}"
                                                BorderThickness="1" CornerRadius="14"
                                                Padding="12,10">
                                            <TextBlock x:Name="SecurityStateText"
                                                       Foreground="{DynamicResource Accent}"
                                                       FontSize="12" FontWeight="Bold"
                                                       Text="verified"/>
                                        </Border>
                                        <TextBox x:Name="SecuritySummaryBox"
                                                 Margin="0,12,0,0"
                                                 Height="120"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 IsReadOnly="True"
                                                 Style="{DynamicResource InputStyle}"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{DynamicResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock x:Name="ActionsTitle" Foreground="{DynamicResource Text}"
                                                   FontSize="18" FontWeight="Bold" Text="Quick actions"/>
                                        <TextBlock x:Name="ActionsHint" Margin="0,6,0,0"
                                                   Foreground="{DynamicResource TextSoft}" FontSize="11"
                                                   Text="Basic controls for the current session."
                                                   TextWrapping="Wrap"/>

                                        <StackPanel Margin="0,16,0,0">
                                            <!-- Ряд 1: Launch + Logout -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button x:Name="LaunchButton" Width="115" Height="40" Margin="0,0,8,8"
                                                        Style="{DynamicResource PrimaryButtonStyle}" Click="Launch_Click" Content="Launch"/>
                                                <Button x:Name="LogoutButton" Width="115" Height="40" Margin="0,0,0,8"
                                                        Style="{DynamicResource ButtonStyle}" Click="Logout_Click" Content="Logout"/>
                                            </StackPanel>
                                            <!-- Ряд 2: Copy + Test Shield -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button x:Name="CopyInfoButton" Width="80" Height="36" Margin="0,0,8,8"
                                                        Style="{DynamicResource ButtonStyle}" Click="CopyInfo_Click" Content="Copy"/>
                                                <Button x:Name="TestShieldButton" Width="80" Height="36" Margin="0,0,8,8"
                                                        Style="{DynamicResource PrimaryButtonStyle}" Click="TestShield_Click" Content="🛡️ TEST"/>
                                            </StackPanel>
                                            <!-- Ряд 3: Logs + Folder -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button x:Name="OpenLogsButton" Width="80" Height="36" Margin="0,0,8,0"
                                                        Style="{DynamicResource ButtonStyle}" Click="OpenLogs_Click" Content="Logs"/>
                                                <Button x:Name="OpenInstallFolderButton" Width="80" Height="36"
                                                        Style="{DynamicResource ButtonStyle}" Click="OpenInstallFolder_Click" Content="Folder"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>

                <Border Grid.Row="3"
                        Margin="18,0,18,16"
                        Background="{DynamicResource StatusBg}"
                        BorderBrush="{DynamicResource StrokeSoft}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusPrefixText" Foreground="{DynamicResource TextMuted}"
                                   FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Text="STATUS"/>
                        <TextBlock x:Name="StatusText" Grid.Column="2"
                                   Foreground="{DynamicResource Accent}"
                                   FontSize="11" VerticalAlignment="Center" Text="ready"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>